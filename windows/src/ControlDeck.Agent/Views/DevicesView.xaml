<UserControl x:Class="ControlDeck.Agent.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Paired Devices" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <ListBox Grid.Row="1" x:Name="DeviceList" />
    </Grid>
</UserControl>
